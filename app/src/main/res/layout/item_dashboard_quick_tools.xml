<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/bg_card_ripple"
    app:rippleColor="@android:color/transparent"
    app:cardBackgroundColor="@color/surface_glass"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="@dimen/card_stroke_width">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="@string/dashboard_quick_tools"
                android:textAppearance="?attr/textAppearanceSubtitle1"
                android:textStyle="bold" />

            <!-- Edit Controls Bar -->
            <LinearLayout
                android:id="@+id/card_edit_controls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/btn_card_resize"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_icon_btn_outlined"
                    android:contentDescription="@string/dashboard_card_resize"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_baseline_compare_arrows_24"
                    app:tint="?attr/colorAccent" />

                <ImageView
                    android:id="@+id/btn_card_delete"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_icon_btn_delete_outlined"
                    android:contentDescription="@string/dashboard_card_delete"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_action_delete"
                    app:tint="@color/material_red_500" />
            </LinearLayout>

        </RelativeLayout>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:columnCount="3">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_import_sub"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:paddingVertical="12dp"
                app:icon="@drawable/ic_av_playlist_add"
                app:iconGravity="top"
                app:iconPadding="4dp"
                app:iconSize="24dp"
                app:iconTint="?attr/colorAccent"
                android:text="@string/dashboard_import_sub"
                android:textColor="?attr/colorAccent"
                android:textSize="11sp"
                android:textAllCaps="false"
                app:backgroundTint="@color/glass_window_tint"
                app:cornerRadius="16dp"
                android:layout_margin="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_refresh_dns"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:paddingVertical="12dp"
                app:icon="@drawable/ic_action_dns"
                app:iconGravity="top"
                app:iconPadding="4dp"
                app:iconSize="24dp"
                app:iconTint="?attr/colorAccent"
                android:text="@string/dashboard_refresh_dns"
                android:textColor="?attr/colorAccent"
                android:textSize="11sp"
                android:textAllCaps="false"
                app:backgroundTint="@color/glass_window_tint"
                app:cornerRadius="16dp"
                android:layout_margin="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_share_config"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:paddingVertical="12dp"
                app:icon="@drawable/ic_social_share"
                app:iconGravity="top"
                app:iconPadding="4dp"
                app:iconSize="24dp"
                app:iconTint="?attr/colorAccent"
                android:text="@string/dashboard_share_config"
                android:textColor="?attr/colorAccent"
                android:textSize="11sp"
                android:textAllCaps="false"
                app:backgroundTint="@color/glass_window_tint"
                app:cornerRadius="16dp"
                android:layout_margin="2dp" />

        </GridLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>