<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp">

    <ImageView
        android:id="@+id/dns_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_action_dns"
        app:tint="?attr/colorAccent"
        android:contentDescription="@string/dashboard_card_dns" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/dns_domain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textStyle="bold"
            tools:text="api.github.com" />

        <TextView
            android:id="@+id/dns_ip_result"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="?attr/textAppearanceCaption"
            android:alpha="0.75"
            tools:text="20.205.243.166 · A" />

    </LinearLayout>

    <TextView
        android:id="@+id/dns_mode_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_segmented_pill"
        android:backgroundTint="@color/glass_window_tint"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:textColor="?attr/colorAccent"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="远程 DNS" />

</LinearLayout>