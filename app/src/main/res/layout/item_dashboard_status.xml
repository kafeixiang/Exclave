<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/bg_card_ripple"
    app:rippleColor="@android:color/transparent"
    app:cardBackgroundColor="@color/surface_glass"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="@dimen/card_stroke_width">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
            android:id="@+id/status_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_service_idle"
            app:tint="?attr/colorAccent"
            android:contentDescription="@string/dashboard_status" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/not_connected"
                android:textAppearance="?attr/textAppearanceHeadline6"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/profile_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/group_status_empty"
                android:textAppearance="?attr/textAppearanceBody2"
                android:alpha="0.7" />
        </LinearLayout>

        <TextView
            android:id="@+id/current_ping"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_segmented_pill"
            android:backgroundTint="@color/glass_window_tint"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="@string/unavailable"
            tools:text="42 ms"
            android:textColor="?attr/colorAccent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Edit Controls Bar -->
        <LinearLayout
            android:id="@+id/card_edit_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/btn_card_resize"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_icon_btn_outlined"
                android:contentDescription="@string/dashboard_card_resize"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_baseline_compare_arrows_24"
                app:tint="?attr/colorAccent" />

            <ImageView
                android:id="@+id/btn_card_delete"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_icon_btn_delete_outlined"
                android:contentDescription="@string/dashboard_card_delete"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_action_delete"
                app:tint="@color/material_red_500" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>