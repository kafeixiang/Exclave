<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/surface_glass"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="@dimen/card_stroke_width">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Background Ambient Shape / Cookie Flower Decoration (FlClash MaterialShapes.cookie12Sided) -->
        <io.nekohasekai.sagernet.ui.widget.CookieDecorationView
            android:id="@+id/bg_cookie_view"
            android:layout_width="190dp"
            android:layout_height="190dp"
            android:layout_gravity="end|top"
            android:layout_marginEnd="-40dp"
            android:layout_marginTop="-40dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp"
            android:paddingVertical="18dp">

            <!-- Left Main Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:orientation="vertical">

                <!-- 1. Header Row (AppGlyphs.status + "状态" + DashboardChip "运行中" / "未运行") -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/status_header_glyph"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_dashboard_status_glyph"
                        app:tint="?android:attr/textColorSecondary" />

                    <TextView
                        android:id="@+id/status_header_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/dashboard_status_header"
                        android:textAppearance="?attr/textAppearanceSubtitle2"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary" />

                    <!-- DashboardChip Status Indicator (Capsule pill) -->
                    <LinearLayout
                        android:id="@+id/chip_status"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_dashboard_chip_idle"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="8dp">

                        <View
                            android:id="@+id/chip_status_dot"
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:layout_marginEnd="5dp"
                            android:background="@drawable/bg_chip_dot_green"
                            android:visibility="gone"
                            tools:visibility="visible" />

                        <TextView
                            android:id="@+id/chip_status_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/status_not_running"
                            tools:text="运行中"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="?android:attr/textColorSecondary" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Spacing -->
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="12dp" />

                <!-- 2. Exit Row (_ExitRow: Country Badge + IP/Node info + IP Chips) -->
                <LinearLayout
                    android:id="@+id/exit_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Country Badge (44x44dp Clover Badge, Clickable to refresh with spin animation) -->
                    <FrameLayout
                        android:id="@+id/btn_country_badge"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_clover_badge"
                        android:clickable="true"
                        android:focusable="true">

                        <!-- Country Flag Icon (CN, HK, US, JP, etc.) -->
                        <ImageView
                            android:id="@+id/icon_country_badge"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_flag_cn"
                            android:contentDescription="@string/dashboard_geoip" />

                        <!-- Fallback Globe Icon -->
                        <ImageView
                            android:id="@+id/icon_country_fallback"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/baseline_public_24"
                            app:tint="?android:attr/textColorSecondary"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/text_country_code"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="?android:attr/textColorPrimary"
                            android:visibility="gone"
                            tools:text="HK" />
                    </FrameLayout>

                    <!-- IP Column -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- Main IP / Node Headline -->
                        <TextView
                            android:id="@+id/text_outbound_ip"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground"
                            android:ellipsize="marquee"
                            android:marqueeRepeatLimit="marquee_forever"
                            android:singleLine="true"
                            android:text="@string/unavailable"
                            tools:text="104.28.19.22"
                            android:textAppearance="?attr/textAppearanceHeadline6"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="?android:attr/textColorPrimary" />

                        <!-- IP Chips Row (_IpChips) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- Chip 1: Node / Protocol Type -->
                            <TextView
                                android:id="@+id/chip_node_type"
                                android:layout_width="wrap_content"
                                android:layout_height="20dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_segmented_pill"
                                android:backgroundTint="@color/glass_window_tint"
                                android:gravity="center"
                                android:paddingHorizontal="7dp"
                                android:maxLines="1"
                                android:singleLine="true"
                                android:ellipsize="end"
                                android:maxWidth="95dp"
                                android:text="@string/unavailable"
                                tools:text="VLESS"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:textColor="?android:attr/textColorSecondary" />

                            <!-- Chip 2: Latency / Quality -->
                            <TextView
                                android:id="@+id/chip_latency"
                                android:layout_width="wrap_content"
                                android:layout_height="20dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_segmented_pill"
                                android:backgroundTint="@color/glass_window_tint"
                                android:gravity="center"
                                android:paddingHorizontal="7dp"
                                android:maxLines="1"
                                android:singleLine="true"
                                android:ellipsize="end"
                                android:maxWidth="130dp"
                                android:text="@string/unavailable"
                                tools:text="质量 良好"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorAccent" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Spacing -->
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="16dp" />

                <!-- 3. Bottom Cells (_Cells: 运行时长 + 出口组织) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Cell 1: 运行时长 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_runtime_label"
                            android:textSize="11sp"
                            android:textColor="?android:attr/textColorSecondary"
                            android:alpha="0.75" />

                        <TextView
                            android:id="@+id/text_cell_runtime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="—"
                            tools:text="01:23:45"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="?android:attr/textColorPrimary" />
                    </LinearLayout>

                    <!-- Cell 2: 出口组织 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.4"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_outbound_org_label"
                            android:textSize="11sp"
                            android:textColor="?android:attr/textColorSecondary"
                            android:alpha="0.75" />

                        <TextView
                            android:id="@+id/text_cell_org"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:text="—"
                            tools:text="Cloudflare, Inc."
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="?android:attr/textColorPrimary" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Right Column: Big Start/Stop Toggle Button (_StartToggle, 88dp) -->
            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- Morph Toggle Button (FlClash MaterialShapes.circle -> cookie9Sided) -->
                <io.nekohasekai.sagernet.ui.widget.MorphToggleButton
                    android:id="@+id/btn_morph_toggle"
                    android:layout_width="86dp"
                    android:layout_height="86dp"
                    android:layout_gravity="center" />

                <!-- Connecting Progress Indicator -->
                <ProgressBar
                    android:id="@+id/btn_toggle_progress"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:indeterminateTint="?attr/colorAccent"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- Top Right Edit Controls (when in edit mode) -->
        <LinearLayout
            android:id="@+id/card_edit_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|top"
            android:layout_margin="12dp"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/btn_card_resize"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_icon_btn_outlined"
                android:contentDescription="@string/dashboard_card_resize"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_baseline_compare_arrows_24"
                app:tint="?attr/colorAccent" />

            <ImageView
                android:id="@+id/btn_card_delete"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_icon_btn_delete_outlined"
                android:contentDescription="@string/dashboard_card_delete"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_action_delete"
                app:tint="@color/material_red_500" />
        </LinearLayout>

    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
