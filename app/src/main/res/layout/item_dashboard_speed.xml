<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/bg_card_ripple"
    app:rippleColor="@android:color/transparent"
    app:cardBackgroundColor="@color/surface_glass"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="@dimen/card_stroke_width">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="@string/dashboard_speed"
                android:textAppearance="?attr/textAppearanceSubtitle1"
                android:textStyle="bold" />

            <!-- Edit Controls Bar -->
            <LinearLayout
                android:id="@+id/card_edit_controls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/btn_card_resize"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_icon_btn_outlined"
                    android:contentDescription="@string/dashboard_card_resize"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_baseline_compare_arrows_24"
                    app:tint="?attr/colorAccent" />

                <ImageView
                    android:id="@+id/btn_card_delete"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_icon_btn_delete_outlined"
                    android:contentDescription="@string/dashboard_card_delete"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_action_delete"
                    app:tint="@color/material_red_500" />
            </LinearLayout>

        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/traffic_downlink_total"
                    android:textAppearance="?attr/textAppearanceCaption"
                    android:alpha="0.7" />

                <TextView
                    android:id="@+id/download_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/speed_zero"
                    android:textAppearance="?attr/textAppearanceHeadline5"
                    android:textColor="?attr/colorAccent"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/traffic_uplink_total"
                    android:textAppearance="?attr/textAppearanceCaption"
                    android:alpha="0.7" />

                <TextView
                    android:id="@+id/upload_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/speed_zero"
                    android:textAppearance="?attr/textAppearanceHeadline5"
                    android:alpha="0.8"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <io.nekohasekai.sagernet.widget.SpeedChartView
            android:id="@+id/speed_chart"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="16dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>