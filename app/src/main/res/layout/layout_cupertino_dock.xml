<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="104dp"
    tools:parentTag="android.widget.FrameLayout">

    <!-- 1. Background Blur Container -->
    <FrameLayout
        android:id="@+id/blur_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:id="@+id/blur_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/surface_glass" />

        <!-- Apple-style Top Highlight Edge (Metallic Glass look) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#B3FFFFFF" />

    </FrameLayout>

    <!-- 2. Animated Wave Layer (Above blur, below buttons) -->
    <io.nekohasekai.sagernet.widget.WaveView
        android:id="@+id/wave_view"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_gravity="bottom"
        android:alpha="0.8" />

    <!-- 3. Foreground Interactive Layer (Sharp) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:id="@+id/speed_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/up_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="2dp"
                android:fontFamily="monospace"
                android:text="@string/speed_zero"
                android:textColor="#3C3C43"
                android:textSize="12sp"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_baseline_arrow_drop_up_24"
                app:drawableTint="@color/material_red_500" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/down_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:drawablePadding="2dp"
                android:fontFamily="monospace"
                android:text="@string/speed_zero"
                android:textColor="#3C3C43"
                android:textSize="12sp"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_baseline_arrow_drop_down_24"
                app:drawableTint="@color/material_green_500" />
        </LinearLayout>

        <View
            android:id="@+id/fab_glow"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:alpha="0"
            android:background="@drawable/bg_ambient_glow"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="@+id/fab"
            app:layout_constraintEnd_toEndOf="@+id/fab"
            app:layout_constraintStart_toStartOf="@+id/fab"
            app:layout_constraintTop_toTopOf="@+id/fab" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@null"
            app:backgroundTint="@android:color/white"
            app:elevation="4dp"
            app:fabSize="normal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_service_idle"
            app:tint="?colorAccent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</merge>
