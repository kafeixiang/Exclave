<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="108dp"
    tools:parentTag="android.widget.FrameLayout">

    <!-- 1. Dock Panel Container (Background + Wave + Speed Click Target) -->
    <FrameLayout
        android:id="@+id/dock_panel"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Background Blur Container with Notched Top Edge -->
        <FrameLayout
            android:id="@+id/blur_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false">

            <io.nekohasekai.sagernet.widget.NotchedDockView
                android:id="@+id/blur_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <!-- Animated Wave Layer -->
        <io.nekohasekai.sagernet.widget.WaveView
            android:id="@+id/wave_view"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_gravity="bottom"
            android:alpha="0.8" />

        <!-- Speed Display & Full Panel Latency Test Click Target -->
        <RelativeLayout
            android:id="@+id/speed_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:id="@+id/speed_text_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="20dp"
                android:orientation="vertical"
                android:padding="2dp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/up_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="3dp"
                    android:text="@string/speed_zero"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_baseline_arrow_drop_up_24"
                    app:drawableTint="@color/dock_status_idle" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/down_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:drawablePadding="3dp"
                    android:text="@string/speed_zero"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_baseline_arrow_drop_down_24"
                    app:drawableTint="@color/dock_status_idle" />
            </LinearLayout>

            <!-- Right-aligned Status Pill & Latency Check Prompt -->
            <LinearLayout
                android:id="@+id/dock_status_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="20dp"
                android:gravity="end"
                android:orientation="vertical"
                android:padding="2dp"
                tools:ignore="RelativeOverlap">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/dock_status_dot"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_segmented_pill"
                        android:backgroundTint="@color/dock_status_idle" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/dock_status_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/not_connected"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/dock_status_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/tap_to_check_connection"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="11sp"
                    android:alpha="0.85" />
            </LinearLayout>

        </RelativeLayout>

    </FrameLayout>

    <!-- 2. FAB Floating Layer (Rendered on VERY TOP, no clipping, half embedded in notch) -->
    <RelativeLayout
        android:id="@+id/fab_container"
        android:layout_width="match_parent"
        android:layout_height="108dp"
        android:clickable="false"
        android:clipChildren="false"
        android:clipToPadding="false">

        <View
            android:id="@+id/fab_glow"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="4dp"
            android:alpha="0"
            android:background="@drawable/bg_ambient_glow"
            android:visibility="visible" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="8dp"
            android:contentDescription="@null"
            app:backgroundTint="?colorAccent"
            app:elevation="2dp"
            app:fabSize="normal"
            app:srcCompat="@drawable/ic_service_idle"
            app:tint="@android:color/white" />

    </RelativeLayout>

</merge>
