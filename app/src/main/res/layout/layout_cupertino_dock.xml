<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="108dp"
    tools:parentTag="android.widget.FrameLayout">

    <!-- 1. Dock Panel Container (Background + Wave + Speed Click Target) -->
    <FrameLayout
        android:id="@+id/dock_panel"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Background Blur Container with Notched Top Edge -->
        <FrameLayout
            android:id="@+id/blur_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false">

            <View
                android:id="@+id/blur_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_dock_notched_panel" />

        </FrameLayout>

        <!-- Animated Wave Layer -->
        <io.nekohasekai.sagernet.widget.WaveView
            android:id="@+id/wave_view"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_gravity="bottom"
            android:alpha="0.8" />

        <!-- Speed Display & Full Panel Latency Test Click Target -->
        <RelativeLayout
            android:id="@+id/speed_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:id="@+id/speed_text_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="20dp"
                android:orientation="vertical"
                android:padding="4dp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/up_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="2dp"
                    android:fontFamily="monospace"
                    android:text="@string/speed_zero"
                    android:textColor="#3C3C43"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_baseline_arrow_drop_up_24"
                    app:drawableTint="@color/material_red_500" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/down_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:drawablePadding="2dp"
                    android:fontFamily="monospace"
                    android:text="@string/speed_zero"
                    android:textColor="#3C3C43"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_baseline_arrow_drop_down_24"
                    app:drawableTint="@color/material_green_500" />
            </LinearLayout>

        </RelativeLayout>

    </FrameLayout>

    <!-- 2. FAB Floating Layer (Rendered on VERY TOP, no clipping, half embedded in notch) -->
    <RelativeLayout
        android:id="@+id/fab_container"
        android:layout_width="match_parent"
        android:layout_height="108dp"
        android:clickable="false"
        android:clipChildren="false"
        android:clipToPadding="false">

        <View
            android:id="@+id/fab_glow"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="4dp"
            android:alpha="0"
            android:background="@drawable/bg_ambient_glow"
            android:visibility="visible" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="8dp"
            android:contentDescription="@null"
            app:backgroundTint="@android:color/white"
            app:elevation="4dp"
            app:fabSize="normal"
            app:srcCompat="@drawable/ic_service_idle"
            app:tint="?colorAccent" />

    </RelativeLayout>

</merge>
