<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:statusBarBackground="@android:color/transparent"
    tools:openDrawer="start">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false">

        <!-- 全局背景模糊层 -->
        <ImageView
            android:id="@+id/global_bg_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null"
            android:alpha="0.2" />

        <!-- 背景霓虹灯影：改用圆形并增加尺寸 -->
        <View
            android:id="@+id/ambient_glow"
            android:layout_width="400dp"
            android:layout_height="400dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_ambient_glow"
            android:alpha="0.1"
            android:visibility="visible" />

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/fragment_holder"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <io.nekohasekai.sagernet.widget.CupertinoDock
            android:id="@+id/cupertino_dock"
            android:layout_width="match_parent"
            android:layout_height="104dp"
            android:layout_gravity="bottom"
            app:layout_behavior="com.google.android.material.behavior.HideBottomViewOnScrollBehavior" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        style="@style/Widget.Design.NavigationView"
        app:insetForeground="@android:color/transparent"
        android:background="@color/surface_glass_heavy"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:itemIconTint="@color/navigation_icon"
        app:itemShapeAppearance="@style/ShapeAppearance.SagerNet.NavItem"
        app:itemShapeFillColor="@color/nav_item_fill"
        app:itemShapeInsetStart="8dp"
        app:itemShapeInsetEnd="8dp"
        app:itemShapeInsetTop="3dp"
        app:itemShapeInsetBottom="3dp"
        app:itemTextColor="@color/navigation_icon"
        app:itemMaxLines="10"
        app:menu="@menu/main_drawer_menu" />

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view_black"
        style="@style/Widget.Design.NavigationView"
        app:insetForeground="@android:color/transparent"
        android:background="@color/surface_glass_heavy"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:itemIconTint="@color/navigation_icon"
        app:itemShapeAppearance="@style/ShapeAppearance.SagerNet.NavItem"
        app:itemShapeFillColor="@color/navigation_item"
        app:itemShapeInsetStart="8dp"
        app:itemShapeInsetEnd="8dp"
        app:itemShapeInsetTop="3dp"
        app:itemShapeInsetBottom="3dp"
        app:itemTextColor="@color/navigation_icon"
        app:itemMaxLines="10"
        app:menu="@menu/main_drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>