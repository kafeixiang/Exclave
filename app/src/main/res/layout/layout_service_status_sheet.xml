<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_window"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Drag handle indicator -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_segmented_pill"
        android:backgroundTint="?android:attr/textColorSecondary"
        android:alpha="0.4" />

    <!-- Sheet Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/btn_sheet_test_all"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/service_status_sheet_title"
                android:textAppearance="?attr/textAppearanceHeadline6"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_latency_desc"
                android:textAppearance="?attr/textAppearanceCaption"
                android:alpha="0.7" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_sheet_test_all"
            style="@style/Widget.Material3.Button.Icon"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="@string/service_check_all"
            app:icon="@drawable/ic_baseline_cached"
            tools:ignore="TouchTargetSizeCheck" />

    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="8dp"
        android:background="@color/card_stroke"
        android:alpha="0.5" />

    <!-- Services List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/sheet_recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        tools:listitem="@layout/item_dashboard_latency_service" />

</LinearLayout>