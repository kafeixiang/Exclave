<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_node"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="4dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="11dp">

        <!-- Squircle Node Icon Container -->
        <FrameLayout
            android:id="@+id/icon_container"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_app_icon_squircle"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/item_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_paper_plane_up"
                android:contentDescription="@string/dashboard_card_profiles" />
        </FrameLayout>

        <!-- Node Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/item_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textAppearance="?attr/textAppearanceBody2"
                android:textStyle="bold"
                tools:text="192.168.1.5:21013" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3.5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/item_type_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_segmented_pill"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="1.5dp"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    tools:text="VLESS" />

                <TextView
                    android:id="@+id/item_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textAppearance="?attr/textAppearanceCaption"
                    android:textSize="11sp"
                    android:alpha="0.7"
                    tools:text="192.168.1.5:21013" />
            </LinearLayout>
        </LinearLayout>

        <!-- Right Side: Latency & Selection Checkmark -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Latency Pill with Signal Dot -->
            <LinearLayout
                android:id="@+id/item_ping_container"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:background="@drawable/bg_segmented_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <View
                    android:id="@+id/item_ping_dot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="4.5dp"
                    android:background="@drawable/bg_circle_dot" />

                <TextView
                    android:id="@+id/item_ping_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="245 ms" />
            </LinearLayout>

            <!-- Filled Circular Check Badge -->
            <ImageView
                android:id="@+id/item_check"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_circle_check_badge"
                android:padding="4dp"
                android:src="@drawable/ic_action_done"
                app:tint="@android:color/white"
                android:visibility="gone"
                tools:visibility="visible"
                android:contentDescription="@string/dashboard_card_profiles" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
