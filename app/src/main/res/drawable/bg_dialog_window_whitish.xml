<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="@android:color/transparent" />
    </item>

    <item
        android:insetLeft="22dp"
        android:insetRight="22dp"
        android:insetTop="22dp"
        android:insetBottom="22dp">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="?attr/glassCardBackground" />
            <stroke android:width="1.5dp" android:color="?attr/glassCardStroke" />
        </shape>
    </item>

    <item
        android:insetLeft="22dp"
        android:insetRight="22dp"
        android:insetTop="22dp"
        android:insetBottom="22dp">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="270"
                android:startColor="#26FFFFFF"
                android:centerColor="#0DFFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>