<?xml version="1.0" encoding="utf-8"?>
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="2dp"
    android:insetRight="2dp">
    <shape android:shape="rectangle">
        <corners android:radius="14dp" />
        <gradient
            android:angle="270"
            android:startColor="@color/tab_glass_pill_start"
            android:endColor="@color/tab_glass_pill_end"
            android:type="linear" />
        <stroke
            android:width="1dp"
            android:color="@color/tab_glass_pill_stroke" />
    </shape>
</inset>
